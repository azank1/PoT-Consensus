# PoT-Consensus Environment Configuration

# Server Configuration
PORT=3000
HOST=localhost

# Database Configuration
DATABASE_PATH=./data/agents.db

# Logging Configuration
LOG_LEVEL=info  # Options: debug, info, warn, error
LOG_ENABLE_COLORS=true
LOG_DIR=./data/logs

# Executor Configuration
EXECUTOR_TIMEOUT=60000  # Default timeout for tasks in milliseconds (60 seconds)
EXECUTOR_CONTINUE_ON_ERROR=true  # Continue executing tasks even if one fails

# Retry Configuration
RETRY_MAX_RETRIES=3
RETRY_INITIAL_DELAY=1000  # Initial delay in milliseconds
RETRY_MAX_DELAY=30000     # Maximum delay in milliseconds
RETRY_BACKOFF_MULTIPLIER=2  # Exponential backoff multiplier

# API Configuration
API_RATE_LIMIT_WINDOW=15  # Rate limit window in minutes
API_RATE_LIMIT_MAX=100    # Max requests per window
API_ENABLE_CORS=true
API_CORS_ORIGIN=*         # CORS allowed origins (* for all)

# Authentication (optional - if implemented)
# API_KEY=your-secret-api-key-here
# JWT_SECRET=your-jwt-secret-here
# JWT_EXPIRATION=24h

# Claude-Flow Configuration (if using real Claude AI)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# CLAUDE_MODEL=claude-3-sonnet-20240229
# CLAUDE_MAX_TOKENS=4096

# MCP Configuration
# MCP_SERVER_URL=http://localhost:8080
# MCP_TIMEOUT=30000

# n8n Configuration
# N8N_WEBHOOK_URL=http://localhost:5678/webhook
# N8N_AUTH_TOKEN=your-n8n-auth-token

# Development
NODE_ENV=development  # Options: development, production, test
